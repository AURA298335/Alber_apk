<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Albert Control" android:textSize="26sp" android:textStyle="bold" android:textColor="#3ed6d6"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Non collegato" android:textColor="#9db3cc"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Connessione" android:textColor="#eef4fb" android:textStyle="bold"/>
    <RadioGroup android:id="@+id/connType" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <RadioButton android:id="@+id/radioBt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Bluetooth" android:checked="true" android:textColor="#eef4fb"/>
        <RadioButton android:id="@+id/radioWifi" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Wi-Fi" android:textColor="#eef4fb"/>
    </RadioGroup>

    <EditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="Indirizzo Bluetooth (AA:BB:CC:DD:EE:FF) oppure IP Wi-Fi"
        android:textColor="#eef4fb" android:textColorHint="#6d8299"/>
    <EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:hint="Porta Wi-Fi (es. 9000)" android:inputType="number"
        android:textColor="#eef4fb" android:textColorHint="#6d8299"/>
    <Button android:id="@+id/connectBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Collega"/>
    <Button android:id="@+id/disconnectBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Scollega"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Controllo manuale" android:textColor="#eef4fb" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnFwd" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="64dp" android:text="Avanti"/>
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="64dp" android:layout_marginStart="8dp" android:text="Indietro"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="64dp" android:text="Sinistra"/>
        <Button android:id="@+id/btnRight" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="64dp" android:layout_marginStart="8dp" android:text="Destra"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Velocità" android:textColor="#eef4fb"/>
    <SeekBar android:id="@+id/speed" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:min="10" android:max="100" android:progress="50"/>

    <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginTop="12dp" android:text="STOP" android:backgroundTint="#ff5d5d"/>
    <Button android:id="@+id/btnRearm" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Riarma dopo arresto"/>
    <Button android:id="@+id/btnTalk" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="LED “sto parlando”"/>

    <TextView android:id="@+id/telemetry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:fontFamily="monospace" android:textColor="#4fd69c"
        android:text="In attesa di telemetria…"/>
    <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:fontFamily="monospace" android:textColor="#9db3cc"
        android:text=""/>
</LinearLayout>
</ScrollView>
